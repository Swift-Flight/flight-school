# Set FLIGHT_SCHOOL_DOMAIN to a bare domain (e.g. flight-school.dev) once
# there's a real one to deploy to — Caddy's automatic HTTPS (a real Let's
# Encrypt cert, zero other config) takes over for any address that isn't
# explicitly http://. The default below includes the scheme specifically
# to opt OUT of that for local `docker compose up`: without it, Caddy
# treats bare "localhost" as a real hostname, provisions a local
# self-signed cert, and 308-redirects all of :80 to :443 — which just
# breaks a plain `curl http://localhost` with no explanation. Verified
# against a real `docker compose up` run, not assumed.
{$FLIGHT_SCHOOL_DOMAIN:http://localhost} {
	# /api/* and /socket → the sessions/execution backend (PLAN §4). Must
	# come before the catch-all `reverse_proxy site:3000` below — Caddy
	# matches in file order, and the catch-all has no path condition, so a
	# `handle`/`handle_path` after it would never be reached (verified
	# against the adapted JSON, not assumed — `caddy adapt` confirms these
	# two routes land ahead of the catch-all in the emitted route list).
	# Plain `handle`, not `handle_path`: the server's own routes are
	# literally `/api/session`, `/api/session/write`, etc. —
	# `handle_path` would strip the `/api` prefix before proxying and the
	# server would 404 every request.
	handle /api/* {
		reverse_proxy server:9100
	}
	handle /socket {
		reverse_proxy server:9100
	}

	# /preview/runner-N/* → the fixed runner pool, WebSockets included —
	# PLAN §4, built in M3. Static routes because the pool size is fixed at
	# deploy time; there is no dynamic service discovery to wire up.
	#
	# Keyed by *service name* (`runner-1`), not a positional index into the
	# pool: the server derives this path from the host component of the
	# runner base URL it already holds for the session
	# (`http://runner-1:9000` → `runner-1`), so there is no second numbering
	# scheme to keep in step with `SessionBroker`'s free-list ordering as
	# runners cycle in and out of it.
	#
	# `handle_path`, not `handle` — it strips the matched prefix before
	# proxying, which is required here: the learner's app is a stock Flight
	# app that knows nothing about being served under a subpath, and its
	# routes are `/hello`, not `/preview/runner-1/hello`. (This is the exact
	# opposite of the `/api/*` decision above, where the server's own routes
	# really do start with `/api` and stripping would 404 everything — same
	# reasoning, opposite conclusion, because the upstream differs.)
	#
	# Known limit, worth knowing before wiring an exercise that trips it:
	# prefix-stripping only works for an app that never emits its own URLs.
	# An app returning HTML with `/static/app.css`, or issuing a redirect to
	# `/login`, sends the browser to the *site* root, not back through this
	# prefix. Fine for the exercises wired today (plain text and JSON); the
	# fix when that changes is a per-runner hostname, which is also PLAN
	# §5's own "separate preview domain" hardening step.
	handle_path /preview/runner-1/* {
		reverse_proxy runner-1:8080
	}
	handle_path /preview/runner-2/* {
		reverse_proxy runner-2:8080
	}
	handle_path /preview/runner-3/* {
		reverse_proxy runner-3:8080
	}
	handle_path /preview/runner-4/* {
		reverse_proxy runner-4:8080
	}

	reverse_proxy site:3000

	encode gzip

	log {
		output stdout
		format console
	}
}
